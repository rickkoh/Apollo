{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "voice-overlay",
  "version": "0.1.0",
  "identifier": "local.voice-overlay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8790"
  },
  "app": {
    "windows": [
      {
        "title": "Voice",
        "width": 380,
        "height": 260,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
