{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Voice Bridge",
  "identifier": "dev.voicebridge.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../../../plugin/.claude-plugin/marketplace.json": "plugin/.claude-plugin/marketplace.json",
      "../../../plugin/voice/.claude-plugin/plugin.json": "plugin/voice/.claude-plugin/plugin.json",
      "../../../plugin/voice/.mcp.json": "plugin/voice/.mcp.json",
      "../../../plugin/voice/dist/channel.js": "plugin/voice/dist/channel.js",
      "../../../plugin/voice/dist/panel-bridge.js": "plugin/voice/dist/panel-bridge.js"
    }
  }
}
