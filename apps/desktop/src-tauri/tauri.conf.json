{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Apollo",
  "identifier": "com.rickkoh.apollo",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../../../plugin/.claude-plugin/marketplace.json": "plugin/.claude-plugin/marketplace.json",
      "../../../plugin/voice/.claude-plugin/plugin.json": "plugin/voice/.claude-plugin/plugin.json",
      "../../../plugin/voice/.mcp.json": "plugin/voice/.mcp.json",
      "../../../plugin/voice/dist/channel.js": "plugin/voice/dist/channel.js",
      "../../../plugin/voice/dist/panel-bridge.js": "plugin/voice/dist/panel-bridge.js"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFRTIyQkIzMjQ3OTJGRjkKUldUNUwza2tzeXZpWHZHU2xHNHl3Q2hMajA0ZzNOaCt3K2MyUi9MZUluekJHaXFpUFNjdXNKWnUK",
      "endpoints": [
        "https://github.com/rickkoh/Apollo/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
