{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "windows": [
    "panel"
  ],
  "permissions": [
    "core:event:default",
    "allow-hub-status",
    "allow-list-sessions",
    "allow-set-target",
    "allow-history",
    "allow-mark-read",
    "allow-rename-session",
    "allow-forget-session",
    "allow-clear-history",
    "allow-get-settings",
    "allow-update-settings",
    "allow-overlay-visible",
    "allow-set-overlay-visible",
    "allow-recent-messages",
    "allow-cli-status",
    "allow-install-cli",
    "allow-plugin-status",
    "allow-ide-panel-status",
    "allow-about",
    "allow-reveal-data-folder",
    "allow-update-status",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-open-at-login",
    "allow-set-open-at-login",
    "core:window:allow-start-dragging",
    "core:path:allow-resolve-directory"
