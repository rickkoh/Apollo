{
  "name": "apollo-desktop",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run plugin && vite",
    "build": "npm run plugin && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "plugin": "npm --prefix ../../plugin/voice run build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
